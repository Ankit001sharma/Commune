PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/communex
JWT_SECRET=replace_with_secure_value
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=replace_with_secure_value
JWT_REFRESH_EXPIRE=30d
CORS_ORIGIN=http://localhost:3000

# Local fallback uploads (temporary/local testing)
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# Cloudinary (recommended permanent image storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=communex

# SMTP email (OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
